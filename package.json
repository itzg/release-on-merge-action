{
  "name": "release-on-merge-action",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:act": "act pull_request -e events/pr-not-merged.json",
    "test:act:patch": "act pull_request -e events/pr-merged-patch.json",
    "test:act:minor": "act pull_request -e events/pr-merged-minor.json",
    "test:act:major": "act pull_request -e events/pr-merged-major.json",
    "typecheck": "tsc --noEmit",
    "build": "rollup --config rollup.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "rollup": "^4.64.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
